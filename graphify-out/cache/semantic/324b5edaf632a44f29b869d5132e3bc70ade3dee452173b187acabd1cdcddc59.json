{"nodes": [{"id": "specs_2026_06_14_rules_engine_design", "label": "Rules Engine Design Spec", "file_type": "document", "source_file": "docs/superpowers/specs/2026-06-14-rules-engine-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_rules_engine", "label": "YAML Rules Engine \u2014 hot-reloadable first-match rules", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-14-rules-engine-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A single block_threshold scalar is too coarse: different event types deserve different confidence requirements. A hot-reloadable YAML rule file lets operators tune blocking without daemon restarts while preserving legacy behavior when the file is absent, ensuring zero-config-change for existing deployments."}, {"id": "concept_hot_reload_pattern", "label": "File Hot-Reload Pattern (mtime+size fileStat)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-14-rules-engine-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Polling mtime+size on each Evaluate/Resolve call avoids background goroutines and inotify syscalls, keeping the implementation simple and portable. Corrupt files keep the last-good state so a partial write never drops active trust or rules mid-operation."}], "edges": [{"source": "specs_2026_06_14_rules_engine_design", "target": "concept_rules_engine", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-06-14-rules-engine-design.md", "source_location": "lines 1-80", "weight": 1.0}, {"source": "specs_2026_06_14_rules_engine_design", "target": "concept_hot_reload_pattern", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_fi