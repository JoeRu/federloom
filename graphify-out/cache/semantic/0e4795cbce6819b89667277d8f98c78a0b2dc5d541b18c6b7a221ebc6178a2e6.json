{"nodes": [{"id": "root_claude", "label": "CLAUDE.md Project Instructions", "file_type": "document", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_seven_invariants", "label": "Seven Non-Negotiable Invariants", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "CLAUDE.md:47-64", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_local_overridability", "label": "Local Overridability (Invariant 1 / Leitprinzip 7)", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All reputation/blocking parameters must remain locally overridable by the operator. Lists are aids, not law. Prevents centralisation of control and preserves operator sovereignty."}, {"id": "concept_ip_personal_data", "label": "IPs as Personal Data (Invariant 2 / spec \u00a79)", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "IPs are cleartext on the wire and treated as personal data under GDPR. Hashing is not anonymisation. Lawful basis is legitimate interest plus decay as automatic deletion."}, {"id": "concept_local_only_whitelist", "label": "Local-Only Whitelist Never Federated (Invariant 3 / spec \u00a76.2)", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Own IP, gateway, DNS, Docker ranges are scope: local-only and must never appear in gossip or any pkg/proto type. Prevents operator topology leakage."}, {"id": "concept_o1_enforcement", "label": "O(1) Enforcement via ipset/nftables (Invariant 4 / spec \u00a711.3)", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Use ipset/nftables sets for O(1) membership checks. Never generate one firewall rule per IP as that is O(n) per packet and melts under attack."}, {"id": "concept_asymmetric_trust_decay", "label": "Asymmetric Trust Decay (Invariant 5 / spec \u00a74.3)", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Trust rises slowly and falls fast. This asymmetry is a core anti-poisoning mechanism. Any decay constant or corroboration change must preserve this."}, {"id": "concept_trust_anchors_removable", "label": "Trust Anchors Locally Removable (Invariant 6 / spec \u00a75.1)", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Project-provided trust anchors are a default, never mandatory. An irremovable anchor re-centralises the system."}, {"id": "concept_security_critical_paths", "label": "Security-Critical Paths (Invariant 7)", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "internal/enforce and scripts/install/ are security-critical. Extra review and conservative defaults are required. Explicit operator confirmation before writing."}, {"id": "concept_ingest_source_interface", "label": "ingest.Source Plugin Interface", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_enforce_sink_interface", "label": "enforce.Sink Plugin Interface", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_three_planes", "label": "Three-Plane Architecture (Data / Control / Observability)", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "CLAUDE.md:34-44", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Data plane (enforce) is small and isolated because it is security-critical. Control plane handles reputation/trust/transport. Observability is opt-in, default OFF \u2014 never mandatory."}, {"id": "concept_gossipsub_dht", "label": "libp2p GossipSub + Kademlia DHT Transport", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "root_claude", "target": "concept_seven_invariants", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": "line 47", "weight": 1.0}, {"source": "root_claude", "target": "concept_ingest_source_interface", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": "line 71", "weight": 1.0}, {"source": "root_claude", "target": "concept_enforce_sink_interface", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": "line 73", "weight": 1.0}, {"source": "root_claude", "target": "concept_three_planes", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": "line 34", "weight": 1.0}, {"source": "root_claude", "target": "concept_adversarial_suite", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": "line 87", "weight": 1.0}, {"source": "root_claude", "target": "concept_gossipsub_dht", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": "li