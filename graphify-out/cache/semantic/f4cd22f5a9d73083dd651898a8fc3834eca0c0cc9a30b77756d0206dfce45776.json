{"nodes": [{"id": "specs_2026_06_12_social_trust_anchors_design", "label": "Social Trust Anchors Design Spec", "file_type": "document", "source_file": "docs/superpowers/specs/2026-06-12-social-trust-anchors-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_social_trust_anchors", "label": "Social Trust Anchors \u2014 Ed25519 Person Identity + Vouching", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-12-social-trust-anchors-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Anchoring a human's Ed25519 key rather than individual machine keys ensures one compromised machine does not burn the whole identity. Trust is inherited by all certified peers; corroboration counts distinct Person groups, preventing Sybil inflation from a single operator running many nodes. Strangers are score-capped so an un-anchored Sybil flood cannot reach the block threshold."}, {"id": "concept_peercert", "label": "PeerCert \u2014 wire vouching certificate (Ed25519)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-12-social-trust-anchors-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Carrying the cert on the wire with each event means verifiers need only the anchored Person public key \u2014 they never have to enumerate or re-import machine IDs as new machines join. Absence of the field means the reporter is treated as a stranger, making the additive wire change backward-compatible."}, {"id": "concept_stranger_score_cap", "label": "Stranger Score Cap \u2014 Sybil flood mitigation", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-12-social-trust-anchors-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Un-anchored strangers collectively contribute at most stranger_score_cap points to any IP's score, regardless of how many Sybil peers report. This prevents a fleet of unvouched peers from pushing an IP past the block threshold by sheer volume."}, {"id": "concept_corroboration_group", "label": "Corroboration Group \u2014 Person-level diversity vote counting", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-12-social-trust-anchors-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Counting distinct anchored Person groups (not peer IDs) as corroboration votes means an operator who runs 10 nodes still contributes only one independent signal per Person. This closes the Sybil corroboration inflation vector while preserving the value of genuine multi-operator consensus."}], "edges": [{"source": "specs_2026_06_12_social_trust_anchors_design", "target": "concept_social_trust_anchors", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-06-12-social-trust-anchors-design.md", "source_location": "lines 1-100", "weight": 1.0}, {"source": "specs_2026_06_12_social_trust_anchors_design", "target": "concept_peercert", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-06-12-social-trust-anchors-design.md", "source_location": "lines 59-80", "weight": 1.0}, {"source": "specs_2026_06_12_social_trust_anchors_design", "target": "concept_stranger_score_cap", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-06-12-social-trust-anchors-design.md", "source_location": "lines 21-24", "weight": 1.0}, {"source": "specs_2026_06_12_social_trust_anchors_design", "target": "concept_corroboration_group", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-06-12-social-trust-anchors-design.md", "source_location": "lines 27-31", "weight": 1.0}, {"source": "concept_social_trust_anchors", "target": "concept_stranger_score_cap", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-06-12-social-trust-anchors-design.md", "source_location": null, "weight": 1.0}, {"source": "concept_social_trust_anchors", "target": "concept_corroboration_group", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-06-12-social-trust-anchors-design.md", "source_location": null, "weight": 1.0}, {"source": "concept_social_trust_anchors", "target": "concept_peercert", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-06-12-social-trust-anchors-design.md", "source_location": null, "weight": 1.0}, {"source": "concept_stranger_score_cap", "target": "concept_corroboration_group", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/superpowers/specs/2026-06-12-social-trust-anchors-design.md", "source_location": null, "weight": 0.85}], "hyperedges": [{"id": "social_trust_feature_set", "label": "Social Trust Anchors Feature \u2014 keys, certs, anchors, vouching, corroboration", "nodes": ["concept_social_trust_anchors", "concept_peercert", "concept_corroboration_group", "concept_stranger_score_cap", "concept_key_management_policy", "concept_schema_version_bump"], "relation": "form", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/superpowers/specs/2026-06-12-social-trust-anchors-design.md"}]}