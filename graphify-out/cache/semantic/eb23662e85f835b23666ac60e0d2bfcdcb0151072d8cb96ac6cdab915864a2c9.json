{"nodes": [{"id": "specs_2026_06_18_dnsbl_design", "label": "DNSBL Server Design Spec", "file_type": "document", "source_file": "docs/superpowers/specs/2026-06-18-dnsbl-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_2026_06_18_dnsbl_query_format", "label": "DNSBL Reversed-IP Query Format", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-18-dnsbl-design.md", "source_location": "line 73", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Standard DNSBL format: reversed IPv4 dotted quad + zone suffix. e.g. 4.3.2.1.dnsbl.mail.example.com means 'look up 1.2.3.4'. Enables any tool that supports DNSBL to query SwarmGuard."}, {"id": "specs_2026_06_18_dnsbl_response_logic", "label": "DNSBL Response Logic (A/TXT/NXDOMAIN)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-18-dnsbl-design.md", "source_location": "line 87", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Listed IPs get A 127.0.0.2 + TXT with score/reasons. Unknown or below-threshold IPs get NXDOMAIN. TTL=60s because scores decay over time."}], "edges": [{"source": "specs_2026_06_18_dnsbl_design", "target": "plans_2026_06_18_dnsbl", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/superpowers/specs/2026-06-18-dnsbl-design.md", "source_location": null, "weight": 1.0}, {"source": "specs_2026_06_18_dnsbl_design", "target": "specs_2026_06_18_dnsbl_query_format", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-06-18-dnsbl-design.md", "source_location": "line 73", "weight": 1.0}, {"source": "specs_2026_06_18_dnsbl_design", "target": "specs_2026_06_18_dnsbl_response_logic", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/spec