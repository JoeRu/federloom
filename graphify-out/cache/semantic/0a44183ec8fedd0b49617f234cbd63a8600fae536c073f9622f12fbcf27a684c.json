{"nodes": [{"id": "specs_2026_06_18_federation_ux_design", "label": "Federation UX Design Spec", "file_type": "document", "source_file": "docs/superpowers/specs/2026-06-18-federation-ux-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_2026_06_18_invitation_protocol", "label": "Invitation Bundle Protocol", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-18-federation-ux-design.md", "source_location": "line 28", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "NewInvitation reads node key to derive peer ID automatically and constructs the full bootstrap_peer multiaddr. Operators never need to type their peer ID manually."}, {"id": "specs_2026_06_18_fingerprint_verification", "label": "Out-of-Band Fingerprint Verification", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-06-18-federation-ux-design.md", "source_location": "line 162", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The joining operator must verify the fingerprint with the inviter over a trusted channel (Signal, encrypted email) before pressing yes. Prevents MITM during trust establishment."}, {"id": "specs_2026_06_18_no_config_autowrite", "label": "No Automatic Config.yaml Writes", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-06-18-federation-ux-design.md", "source_location": "line 13", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All commands print what to paste; the operator decides when to apply it. Prevents surprising config changes and keeps operator in control (spec Leitprinzip 7)."}], "edges": [{"source": "specs_2026_06_18_federation_ux_design", "target": "plans_2026_06_18_federation_ux", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/superpowers/specs/2026-06-18-federation-ux-design.md", "source_location": null, "weight": 1.0}, {"source": "specs_2026_06_18_federation_ux_design", "target": "specs_2026_06_18_invitation_protocol", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-06-18-federation-ux-design.md", "source_location": "line 28", "weight": 1.0}, {"source": "specs_2026_06_18_federation_ux_design", "target": "specs_2026_06_18_fingerprint_verification", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-06-18-federation-ux-design.md", "source_location": "line 162", "weight": 1.0}, {"source": "specs_2026_06_18_federation_ux_design", "target": "specs_2026_06_18_no_config_autowrite", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-06-18-federation-ux-design.md", "source_location": "line 13", "weight": 1.0}], "hyperedges": []}