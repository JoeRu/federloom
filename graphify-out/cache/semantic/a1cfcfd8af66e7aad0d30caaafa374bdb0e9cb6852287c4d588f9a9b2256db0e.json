{"nodes": [{"id": "swarmguard_readme", "label": "SwarmGuard README", "file_type": "document", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "swarmguard_readme_decentralised_federated_ip_blocklist", "label": "Decentralised Federated IP Blocklist (Core Concept)", "file_type": "concept", "source_file": "README.md", "source_location": "line 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "IP reputation shared peer-to-peer between self-hosted servers with local sovereignty at its core. Designed as a decentralised counterpart to CrowdSec's central community network. Trust is federated (Mastodon-style trust domains), block/allow lists are only aids the operator can always override, and IP reputation decays over time (doubles as GDPR storage-limitation mechanism)."}, {"id": "swarmguard_readme_local_sovereignty", "label": "Local Sovereignty Principle", "file_type": "rationale", "source_file": "README.md", "source_location": "line 9", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lists are aids, not law. Every reputation/blocking parameter must remain locally overridable (spec Leitprinzip 7). Operator can always override any parameter - the system must never enforce without allowing override."}, {"id": "swarmguard_readme_anti_poisoning", "label": "Anti-Poisoning by Structure", "file_type": "rationale", "source_file": "README.md", "source_location": "line 22-25", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ground-truth anchors (honeypots or spamtrap-semantics), diversity-weighted corroboration (N independent ASNs/countries, not N nodes), and asymmetric reputation decay (trust rises slowly, falls fast). Security by structure not blind trust."}, {"id": "swarmguard_readme_gdpr_by_design", "label": "GDPR by Design", "file_type": "rationale", "source_file": "README.md", "source_location": "line 33-35", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "IPs are personal data; lawful basis is legitimate interest in network security (Art. 6(1)(f), Recital 49), with decay as automatic deletion and the local admin as controller. Decay doubles as GDPR storage-limitation mechanism."}, {"id": "swarmguard_readme_federated_trust", "label": "Federated Trust Model", "file_type": "concept", "source_file": "README.md", "source_location": "line 27-30", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Curatable list of signed trust anchors plus own subnets that federate (with trust discount) or stay isolated. Defederation answers a bad subnet. Mastodon-style trust domain model."}, {"id": "swarmguard_readme_scaling_by_querying", "label": "Scaling by Querying Not Replicating", "file_type": "rationale", "source_file": "README.md", "source_location": "line 31-33", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "DNSBL-style on-demand lookup + compact local bloom filter; ipset/nftables (O(1)), never a rule per IP. The daemon is a good neighbour \u2014 resource-budgeted, sheds load under attack."}, {"id": "swarmguard_readme_ingest_source", "label": "ingest.Source Plugin Interface", "file_type": "concept", "source_file": "README.md", "source_location": "line 69-71", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "swarmguard_readme_enforce_sink", "label": "enforce.Sink Plugin Interface", "file_type": "concept", "source_file": "README.md", "source_location": "line 72-73", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "swarmguard_readme", "target": "swarmguard_readme_decentralised_federated_ip_blocklist", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "line 3-12", "weight": 1.0}, {"source": "swarmguard_readme", "target": "swarmguard_readme_local_sovereignty", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "line 9", "weight": 1.0}, {"source": "swarmguard_readme", "target": "swarmguard_readme_anti_poisoning", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "line 22-25", "weight": 1.0}, {"source": "swarmguard_readme", "target": "swarmguard_readme_gdpr_by_design", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "line 33-35", "weight": 1.0}, {"source": "swarmguard_readme", "target": "swarmguard_readme_federated_trust", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "line 27-30", "weight": 1.0}, {"source": "swarmguard_readme", "target": "swarmguard_readme_scaling_by_querying", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "line 31-33", "weight": 1.0}, {"source": "swarmguard_readme", "target": "swarmguard_readme_ingest_source", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "line 69-71", "weight": 1.0}, {"source": "swarmguard_readme", "target": "swarmguard_readme_enforce_sink", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "line 72-73", "weight": 1.0}, {"source": "swarmguard_readme_anti_poisoning", "target": "swarmguard_changelog_social_trust_anchors", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "README.md", "source_location": null, "weight": 0.85}, {"source": "swarmguard_readme_federated_trust", "target": "examples_config_federated_import_discount", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "README.md", "source_location": null, "weight": 0.85}, {"source": "swarmguard_readme_gdpr_by_design", "target": "concept_decay_half_life", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "README.md", "source_location": null, "weight": 0.85}, {"source": "swarmguard_readme_scaling_by_querying", "target": "concept_ipset_enforcement", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "README.md", "source_location": null, "weight": 0.85}], "hyperedges": []}