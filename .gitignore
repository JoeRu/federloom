# Build output
/bin/
*.exe
/swarmd
/swarmctl

# Local runtime state
*.db
/data/
/var/

# Secrets — never commit keys or filled-in configs
*.key
*.pem
config.local.yaml
cs-firewall-bouncer.yaml
**/.env

# Generated by deploy/redeploy.sh — contains trust bundle material, never commit
honeypot-invite.json

# Per-node deploy secrets — copy from .env.example and fill in
deploy/honeypot/.env
deploy/mailcow/.env
deploy/wordpress/.env

# Go
vendor/
